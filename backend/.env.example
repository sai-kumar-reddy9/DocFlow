PROJECT_NAME="DocFlow - Secure Document Workflow Platform"
API_V1_STR="/api/v1"
DEBUG=True

# JWT Authentication & Security Configuration
SECRET_KEY="your-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME="access_token"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="docflow_db"

# Database Connection URLs
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/docflow_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/docflow_db"
USE_SQLITE_FALLBACK=True

# Redis Cache & Rate Limiting Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=300
ENABLE_REDIS_CACHE=True
